DATABASE_URL="postgresql://username:password@localhost:5432/Hemoconnect"
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
ALERT_WAVE_1_RADIUS_KM=5
ALERT_WAVE_2_RADIUS_KM=15
ALERT_WAVE_3_RADIUS_KM=30
ALERT_WAVE_INTERVAL_MINUTES=30
DONATION_WAITING_PERIOD_DAYS=90
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=/api
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="HemoConnect <no-reply@example.com>"
EMAIL_WORKER_INTERVAL_MS=30000
