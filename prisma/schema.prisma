
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InstitutionType {
  HOSPITAL
  KNBTS_CENTRE
}

enum QuestionnaireVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionnaireAnswerType {
  YES_NO
  TEXT
  DATE
  NUMBER
  OPTION
  DECLARATION_ACKNOWLEDGEMENT
  DERIVED_YES_NO
}

enum QuestionnaireSubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  DECLINED
}

enum QuestionnaireReviewDecision {
  APPROVED
  DECLINED
}

enum QuestionnaireClinicalDecision {
  ACCEPT
  DEFER
}

enum QuestionnaireApprovalStatus {
  ACTIVE
  CONSUMED
  EXPIRED
}

enum QuestionnaireBookingAssociationStatus {
  ACTIVE
  CANCELLED_RELEASED
  CANCELLED_EXPIRED
  COMPLETED_CONSUMED
}

enum QuestionnaireTravelPeriodUnit {
  MONTHS
  YEARS
}

model User {
  userId    Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  password  String
  role      String
  status    String   @default("ACTIVE")
  mustChangePassword Boolean @default(false)
  createdAt DateTime @default(now())

updatedAt DateTime @default(now()) @updatedAt


  admin                   Admin?
  donor                   Donor?
  hospitalStaff           HospitalStaff?
  knbtsStaff              KnbtsStaff?
  notifications           Notification[]
  alerts                  Alert[]                @relation("UserReceivesAlerts")
  auditLogs               AuditLog[]             @relation("UserAuditLogs")
  inventoryTransactions   InventoryTransaction[] @relation("UserInventoryTransactions")
  createdEmergencyRequests EmergencyRequest[]     @relation("UserCreatesEmergencyRequests")
  passwordResetTokens PasswordResetToken[]
}

model Admin {
  adminId Int @id @default(autoincrement())
  userId  Int @unique
  user    User @relation(fields: [userId], references: [userId], onDelete: Cascade)

}


model Donor {
  donorId           Int      @id @default(autoincrement())
  firstName         String
  lastName          String
  bloodType         String?
  birthDate         DateTime?
  gender            String?
  address           String?
  latitude          Float?
  longitude         Float?
  donationFrequency String?
  isEligible        Boolean  @default(true)
  lastDonationDate  DateTime?
  createdAt         DateTime @default(now())

updatedAt DateTime @default(now()) @updatedAt


  userId Int  @unique
  user   User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  appointments                   Appointment[]
  donationRecords                DonationRecord[]
  medicalCheckups                MedicalCheckup[]
  requestMatches                 RequestMatch[]
  questionnaireSubmissions       DonorQuestionnaireSubmission[]
  questionnaireApprovals         QuestionnaireApproval[]
}



model Hospital {
  hospitalId  Int      @id @default(autoincrement())
  name        String
  location    String
  contactInfo String
  institutionType    InstitutionType @default(HOSPITAL)
  latitude    Float?
  longitude   Float?
  locationVerifiedAt DateTime?
  locationVerifiedByStaffId Int?
  locationVerifiedBy HospitalStaff? @relation("HospitalLocationVerifier", fields: [locationVerifiedByStaffId], references: [staffId], onDelete: SetNull)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

updatedAt DateTime @default(now()) @updatedAt


  staff          HospitalStaff[]
  knbtsStaff     KnbtsStaff[]
  appointments   Appointment[]
  donationRecords DonationRecord[]
  inventories    BloodInventory[]
  stockSettings  HospitalStockSettings?
  medicalCheckups MedicalCheckup[]
  emergencyRequests EmergencyRequest[]
  appointmentSlots AppointmentSlot[]
}

model HospitalStaff {
  staffId     Int      @id @default(autoincrement())
  designation String
  createdAt   DateTime @default(now())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [hospitalId], onDelete: Restrict)

  donationRecords DonationRecord[]
  medicalCheckups MedicalCheckup[]
  createdEmergencyRequests EmergencyRequest[] @relation("StaffCreatesEmergencyRequests")
  verifiedHospitalLocations Hospital[] @relation("HospitalLocationVerifier")
  createdAppointmentSlots AppointmentSlot[]
}

model KnbtsStaff {
  knbtsStaffId Int      @id @default(autoincrement())
  designation  String?
  createdAt    DateTime @default(now())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  centreId Int
  centre   Hospital @relation(fields: [centreId], references: [hospitalId], onDelete: Restrict)

  donationRecords              DonationRecord[]
  medicalCheckups              MedicalCheckup[]
  questionnaireReviews         QuestionnaireReview[]
  questionnaireAssessments     QuestionnaireClinicalAssessment[]
}

model AppointmentSlot {
  slotId      Int      @id @default(autoincrement())
  slotDate    DateTime @db.Date
  time        String
  capacity    Int
  bookedCount Int      @default(0)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [hospitalId], onDelete: Cascade)

  createdByStaffId Int
  createdByStaff   HospitalStaff @relation(fields: [createdByStaffId], references: [staffId], onDelete: Restrict)

  appointments Appointment[]

  @@unique([hospitalId, slotDate, time])
  @@index([hospitalId, slotDate, status])
}

model Appointment {
  appointmentId Int      @id @default(autoincrement())
  date          DateTime
  time          String
  purpose       String
  status        String   @default("SCHEDULED")
  notes         String?
  createdAt     DateTime @default(now())

updatedAt DateTime @default(now()) @updatedAt


  donorId Int?
  donor   Donor? @relation(fields: [donorId], references: [donorId], onDelete: SetNull)

  hospitalId Int?
  hospital   Hospital? @relation(fields: [hospitalId], references: [hospitalId], onDelete: SetNull)

  slotId Int?
  slot   AppointmentSlot? @relation(fields: [slotId], references: [slotId], onDelete: SetNull)

  donationRecords DonationRecord[]
  questionnaireClinicalAssessments QuestionnaireClinicalAssessment[]
  questionnaireBookingAssociations QuestionnaireBookingAssociation[]

  @@unique([appointmentId, donorId])
}

model DonationRecord {
  donationId   Int      @id @default(autoincrement())
  donationDate DateTime
  bloodType    String
  quantity     Int      @default(1)
  status       String   @default("RECORDED")
  notes        String?
  createdAt    DateTime @default(now())

  donorId Int
  donor   Donor @relation(fields: [donorId], references: [donorId], onDelete: Restrict)

  appointmentId Int?
  appointment   Appointment? @relation(fields: [appointmentId], references: [appointmentId], onDelete: SetNull)

  staffId Int?
  hospitalStaff HospitalStaff? @relation(fields: [staffId], references: [staffId], onDelete: SetNull)

  recordedByKnbtsStaffId Int?
  recordedByKnbtsStaff   KnbtsStaff? @relation(fields: [recordedByKnbtsStaffId], references: [knbtsStaffId], onDelete: SetNull)

  hospitalId Int?
  hospital   Hospital? @relation(fields: [hospitalId], references: [hospitalId], onDelete: SetNull)

  emergencyRequests EmergencyRequest[] @relation("DonationFulfillsRequests")
}

model MedicalCheckup {
  checkupId  Int      @id @default(autoincrement())
  checkupDate DateTime @default(now())
  hemoglobin Float?
  bloodPressure String?
  weight     Float?
  result     String
  notes      String?
  createdAt  DateTime @default(now())

  donorId Int
  donor   Donor @relation(fields: [donorId], references: [donorId], onDelete: Cascade)

  staffId Int?
  hospitalStaff HospitalStaff? @relation(fields: [staffId], references: [staffId], onDelete: SetNull)

  recordedByKnbtsStaffId Int?
  recordedByKnbtsStaff   KnbtsStaff? @relation(fields: [recordedByKnbtsStaffId], references: [knbtsStaffId], onDelete: SetNull)

  hospitalId Int?
  hospital   Hospital? @relation(fields: [hospitalId], references: [hospitalId], onDelete: SetNull)
}

model BloodInventory {
  inventoryId   Int      @id @default(autoincrement())
  bloodType     String
  unitsAvailable Int     @default(0)
  minimumUnits  Int      @default(5)
  updatedAt     DateTime @default(now()) @updatedAt
  createdAt     DateTime @default(now())

  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [hospitalId], onDelete: Cascade)

  transactions InventoryTransaction[]

  @@unique([hospitalId, bloodType])
}

model HospitalStockSettings {
  settingsId                 Int      @id @default(autoincrement())
  historicalWindowDays       Int      @default(30)
  replenishmentLeadTimeDays   Int?
  safetyBufferDays            Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @default(now()) @updatedAt

  hospitalId Int      @unique
  hospital   Hospital @relation(fields: [hospitalId], references: [hospitalId], onDelete: Cascade)
}

model InventoryTransaction {
  transactionId Int      @id @default(autoincrement())
  transactionType String
  unitsChanged  Int
  reason        String?
  createdAt     DateTime @default(now())

  inventoryId Int
  inventory   BloodInventory @relation(fields: [inventoryId], references: [inventoryId], onDelete: Cascade)

  performedByUserId Int?
  performedByUser   User? @relation("UserInventoryTransactions", fields: [performedByUserId], references: [userId], onDelete: SetNull)

  requestId Int?
  request   EmergencyRequest? @relation(fields: [requestId], references: [requestId], onDelete: SetNull)
}

model EmergencyRequest {
  requestId        Int      @id @default(autoincrement())
  bloodType        String
  quantityRequired Int
  urgencyLevel     String
  status           String   @default("PENDING")
  latitude         Float?
  longitude        Float?
  currentWave      Int      @default(0)
  lastAlertAt      DateTime?
  requestDate      DateTime @default(now())
  neededBy         DateTime
  notes            String?
  fulfilledAt      DateTime?
  fulfilledQuantity Int?
  outcomeNotes     String?
  createdAt        DateTime @default(now())

updatedAt DateTime @default(now()) @updatedAt


  patientReference String? @db.VarChar(60)

  hospitalId Int?
  hospital   Hospital? @relation(fields: [hospitalId], references: [hospitalId], onDelete: SetNull)

  requestedByUserId Int?
  requestedByUser   User? @relation("UserCreatesEmergencyRequests", fields: [requestedByUserId], references: [userId], onDelete: SetNull)

  createdByStaffId Int?
  createdByStaff   HospitalStaff? @relation("StaffCreatesEmergencyRequests", fields: [createdByStaffId], references: [staffId], onDelete: SetNull)

  donationRecords       DonationRecord[]       @relation("DonationFulfillsRequests")
  matches               RequestMatch[]
  alerts                Alert[]
  notifications         Notification[]
  inventoryTransactions InventoryTransaction[]
  @@index([hospitalId, status, neededBy])
}

model RequestMatch {
  matchId     Int      @id @default(autoincrement())
  status      String   @default("MATCHED")
  wave        Int      @default(1)
  distanceKm  Float?
  notifiedAt  DateTime?
  responseAt  DateTime?
  createdAt   DateTime @default(now())

  requestId Int
  request   EmergencyRequest @relation(fields: [requestId], references: [requestId], onDelete: Cascade)

  donorId Int
  donor   Donor @relation(fields: [donorId], references: [donorId], onDelete: Cascade)

  @@unique([requestId, donorId])
}

model Alert {
  alertId   Int      @id @default(autoincrement())
  alertType String
  channel   String
  message   String
  status    String   @default("PENDING")
  sentAt    DateTime?
  createdAt DateTime @default(now())

  requestId Int?
  emergencyRequest EmergencyRequest? @relation(fields: [requestId], references: [requestId], onDelete: SetNull)

  userId Int?
  user   User? @relation("UserReceivesAlerts", fields: [userId], references: [userId], onDelete: SetNull)
}

model Notification {
  notificationId Int      @id @default(autoincrement())
  type           String
  channel        String
  title          String?
  message        String
  status         String   @default("PENDING")
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  userId Int?
  user   User? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  requestId Int?
  request   EmergencyRequest? @relation(fields: [requestId], references: [requestId], onDelete: SetNull)

}

model PasswordResetToken {
  tokenId   Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailOutbox {
  emailId        Int      @id @default(autoincrement())
  recipientEmail String
  template       String
  payload        Json
  status         String   @default("QUEUED")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lastError      String?
  createdAt      DateTime @default(now())
  sentAt         DateTime?
  processingAt   DateTime?

  @@index([status, nextAttemptAt])
}

model AuditLog {
  auditLogId Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actorUserId Int?
  actorUser   User? @relation("UserAuditLogs", fields: [actorUserId], references: [userId], onDelete: SetNull)
}

model QuestionnaireVersion {
  questionnaireVersionId Int      @id @default(autoincrement())
  versionNumber          Int      @unique
  title                  String
  status                 QuestionnaireVersionStatus @default(DRAFT)
  effectiveFrom          DateTime?
  effectiveTo            DateTime?
  publishedAt            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  questions    QuestionnaireQuestion[]
  submissions  DonorQuestionnaireSubmission[]

  @@index([status, effectiveFrom])
  @@index([publishedAt])
}

model QuestionnaireQuestion {
  questionnaireQuestionId Int      @id @default(autoincrement())
  versionId               Int
  version                 QuestionnaireVersion @relation(fields: [versionId], references: [questionnaireVersionId], onDelete: Restrict)
  questionKey             String
  numberLabel             String
  subsectionLabel         String?
  prompt                  String
  answerType              QuestionnaireAnswerType
  parentQuestionId        Int?
  parentQuestion          QuestionnaireQuestion? @relation("QuestionnaireQuestionParent", fields: [parentQuestionId], references: [questionnaireQuestionId], onDelete: Restrict)
  childQuestions          QuestionnaireQuestion[] @relation("QuestionnaireQuestionParent")
  displayOrder            Int
  required                Boolean @default(true)
  isDerived               Boolean @default(false)
  createdAt               DateTime @default(now())

  options  QuestionnaireOption[]
  answers  QuestionnaireAnswer[]

  @@unique([versionId, questionKey])
  @@unique([versionId, displayOrder])
  @@unique([questionnaireQuestionId, versionId])
  @@index([versionId, parentQuestionId, displayOrder])
}

model QuestionnaireOption {
  optionId      Int      @id @default(autoincrement())
  questionId    Int
  question      QuestionnaireQuestion @relation(fields: [questionId], references: [questionnaireQuestionId], onDelete: Restrict)
  optionKey     String
  optionLabel   String
  displayOrder  Int
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())

  answers QuestionnaireAnswer[]

  @@unique([questionId, optionKey])
  @@unique([questionId, displayOrder])
  @@unique([optionId, questionId])
  @@index([questionId, isActive])
}

model DonorQuestionnaireSubmission {
  submissionId                  Int      @id @default(autoincrement())
  donorId                       Int
  donor                         Donor @relation(fields: [donorId], references: [donorId], onDelete: Restrict)
  versionId                     Int
  version                       QuestionnaireVersion @relation(fields: [versionId], references: [questionnaireVersionId], onDelete: Restrict)
  status                        QuestionnaireSubmissionStatus @default(DRAFT)
  submittedAt                   DateTime?
  declarationAcknowledgedAt     DateTime?
  donorInformationSnapshot      Json?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @default(now()) @updatedAt

  answers      QuestionnaireAnswer[]
  review       QuestionnaireReview?
  assessments  QuestionnaireClinicalAssessment[]
  approvals    QuestionnaireApproval[]

  @@unique([submissionId, donorId])
  @@unique([submissionId, versionId])
  @@index([donorId, status, submittedAt])
  @@index([versionId, status])
  @@index([submittedAt])
}

model QuestionnaireAnswer {
  answerId             Int      @id @default(autoincrement())
  submissionId         Int
  versionId            Int
  submission           DonorQuestionnaireSubmission @relation(fields: [submissionId, versionId], references: [submissionId, versionId], onDelete: Restrict)
  questionId           Int
  question             QuestionnaireQuestion @relation(fields: [questionId, versionId], references: [questionnaireQuestionId, versionId], onDelete: Restrict)
  answerOptionId       Int?
  answerOption         QuestionnaireOption? @relation(fields: [answerOptionId, questionId], references: [optionId, questionId], onDelete: Restrict)
  textValue            String?
  dateValue            DateTime? @db.Date
  numberValue          Float?
  booleanValue         Boolean?
  travelPeriodValue    Int?
  travelPeriodUnit     QuestionnaireTravelPeriodUnit?
  answeredAt           DateTime @default(now())

  @@unique([submissionId, questionId])
  @@index([submissionId, versionId])
  @@index([questionId, versionId])
  @@index([answerOptionId, questionId])
}

model QuestionnaireReview {
  reviewId        Int      @id @default(autoincrement())
  submissionId    Int      @unique
  submission      DonorQuestionnaireSubmission @relation(fields: [submissionId], references: [submissionId], onDelete: Restrict)
  reviewerStaffId Int
  reviewerStaff   KnbtsStaff @relation(fields: [reviewerStaffId], references: [knbtsStaffId], onDelete: Restrict)
  decision        QuestionnaireReviewDecision
  reviewedAt      DateTime
  declineReason   String?
  internalNote    String?

  approval    QuestionnaireApproval?
  assessments QuestionnaireClinicalAssessment[]

  @@unique([submissionId, reviewId])
  @@index([reviewerStaffId, reviewedAt])
  @@index([decision, reviewedAt])
}

model QuestionnaireClinicalAssessment {
  clinicalAssessmentId     Int      @id @default(autoincrement())
  submissionId             Int
  donorId                  Int
  submission               DonorQuestionnaireSubmission @relation(fields: [submissionId, donorId], references: [submissionId, donorId], onDelete: Restrict)
  assessedByKnbtsStaffId   Int
  assessedByKnbtsStaff     KnbtsStaff @relation(fields: [assessedByKnbtsStaffId], references: [knbtsStaffId], onDelete: Restrict)
  reviewId                 Int?
  review                   QuestionnaireReview? @relation(fields: [submissionId, reviewId], references: [submissionId, reviewId], onDelete: Restrict)
  appointmentId            Int?
  appointment              Appointment? @relation(fields: [appointmentId, donorId], references: [appointmentId, donorId], onDelete: Restrict)
  assessmentDate           DateTime @default(now())
  decision                 QuestionnaireClinicalDecision
  weightKg                 Decimal? @db.Decimal(5, 2)
  bloodPressure            String?
  deferralPeriodDays       Int?
  deferralUntil            DateTime? @db.Date
  reason                   String?
  createdAt                DateTime @default(now())

  @@index([submissionId, assessmentDate])
  @@index([submissionId, donorId])
  @@index([reviewId, submissionId])
  @@index([assessedByKnbtsStaffId, assessmentDate])
  @@index([appointmentId, donorId])
}

model QuestionnaireApproval {
  approvalId   Int      @id @default(autoincrement())
  submissionId Int
  donorId      Int
  submission   DonorQuestionnaireSubmission @relation(fields: [submissionId, donorId], references: [submissionId, donorId], onDelete: Restrict)
  reviewId     Int      @unique
  review       QuestionnaireReview @relation(fields: [submissionId, reviewId], references: [submissionId, reviewId], onDelete: Restrict)
  donor        Donor @relation(fields: [donorId], references: [donorId], onDelete: Restrict)
  approvedAt   DateTime
  expiresAt    DateTime
  status       QuestionnaireApprovalStatus @default(ACTIVE)
  consumedAt   DateTime?
  createdAt    DateTime @default(now())

  bookingAssociations QuestionnaireBookingAssociation[]

  @@unique([submissionId, reviewId])
  @@index([submissionId, donorId])
  @@index([submissionId, reviewId])
  @@index([donorId, status, expiresAt])
  @@index([expiresAt, status])
}

model QuestionnaireBookingAssociation {
  bookingAssociationId Int      @id @default(autoincrement())
  approvalId           Int
  approval             QuestionnaireApproval @relation(fields: [approvalId], references: [approvalId], onDelete: Restrict)
  appointmentId        Int      @unique
  appointment          Appointment @relation(fields: [appointmentId], references: [appointmentId], onDelete: Restrict)
  authorizedAt         DateTime
  status               QuestionnaireBookingAssociationStatus @default(ACTIVE)
  releasedAt           DateTime?
  consumedAt           DateTime?
  createdAt            DateTime @default(now())

  @@index([approvalId, status])
  @@index([appointmentId, status])
}
