
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId    Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  password  String
  role      String
  status    String   @default("ACTIVE")
  mustChangePassword Boolean @default(false)
  createdAt DateTime @default(now())

updatedAt DateTime @default(now()) @updatedAt


  admin                   Admin?
  donor                   Donor?
  hospitalStaff           HospitalStaff?
  notifications           Notification[]
  alerts                  Alert[]                @relation("UserReceivesAlerts")
  auditLogs               AuditLog[]             @relation("UserAuditLogs")
  inventoryTransactions   InventoryTransaction[] @relation("UserInventoryTransactions")
  createdEmergencyRequests EmergencyRequest[]     @relation("UserCreatesEmergencyRequests")
  passwordResetTokens PasswordResetToken[]
}

model Admin {
  adminId Int @id @default(autoincrement())
  userId  Int @unique
  user    User @relation(fields: [userId], references: [userId], onDelete: Cascade)

}


model Donor {
  donorId           Int      @id @default(autoincrement())
  firstName         String
  lastName          String
  bloodType         String?
  birthDate         DateTime?
  gender            String?
  address           String?
  latitude          Float?
  longitude         Float?
  donationFrequency String?
  isEligible        Boolean  @default(true)
  lastDonationDate  DateTime?
  createdAt         DateTime @default(now())

updatedAt DateTime @default(now()) @updatedAt


  userId Int  @unique
  user   User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  appointments       Appointment[]
  donationRecords    DonationRecord[]
  medicalCheckups    MedicalCheckup[]
  requestMatches     RequestMatch[]
}



model Hospital {
  hospitalId  Int      @id @default(autoincrement())
  name        String
  location    String
  contactInfo String
  latitude    Float?
  longitude   Float?
  locationVerifiedAt DateTime?
  locationVerifiedByStaffId Int?
  locationVerifiedBy HospitalStaff? @relation("HospitalLocationVerifier", fields: [locationVerifiedByStaffId], references: [staffId], onDelete: SetNull)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

updatedAt DateTime @default(now()) @updatedAt


  staff          HospitalStaff[]
  appointments   Appointment[]
  donationRecords DonationRecord[]
  inventories    BloodInventory[]
  stockSettings  HospitalStockSettings?
  medicalCheckups MedicalCheckup[]
  emergencyRequests EmergencyRequest[]
  appointmentSlots AppointmentSlot[]
}

model HospitalStaff {
  staffId     Int      @id @default(autoincrement())
  designation String
  createdAt   DateTime @default(now())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [hospitalId], onDelete: Restrict)

  donationRecords DonationRecord[]
  medicalCheckups MedicalCheckup[]
  createdEmergencyRequests EmergencyRequest[] @relation("StaffCreatesEmergencyRequests")
  verifiedHospitalLocations Hospital[] @relation("HospitalLocationVerifier")
  createdAppointmentSlots AppointmentSlot[]
}

model AppointmentSlot {
  slotId      Int      @id @default(autoincrement())
  slotDate    DateTime @db.Date
  time        String
  capacity    Int
  bookedCount Int      @default(0)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [hospitalId], onDelete: Cascade)

  createdByStaffId Int
  createdByStaff   HospitalStaff @relation(fields: [createdByStaffId], references: [staffId], onDelete: Restrict)

  appointments Appointment[]

  @@unique([hospitalId, slotDate, time])
  @@index([hospitalId, slotDate, status])
}

model Appointment {
  appointmentId Int      @id @default(autoincrement())
  date          DateTime
  time          String
  purpose       String
  status        String   @default("SCHEDULED")
  notes         String?
  createdAt     DateTime @default(now())

updatedAt DateTime @default(now()) @updatedAt


  donorId Int?
  donor   Donor? @relation(fields: [donorId], references: [donorId], onDelete: SetNull)

  hospitalId Int?
  hospital   Hospital? @relation(fields: [hospitalId], references: [hospitalId], onDelete: SetNull)

  slotId Int?
  slot   AppointmentSlot? @relation(fields: [slotId], references: [slotId], onDelete: SetNull)

  donationRecords DonationRecord[]
}

model DonationRecord {
  donationId   Int      @id @default(autoincrement())
  donationDate DateTime
  bloodType    String
  quantity     Int      @default(1)
  status       String   @default("RECORDED")
  notes        String?
  createdAt    DateTime @default(now())

  donorId Int
  donor   Donor @relation(fields: [donorId], references: [donorId], onDelete: Restrict)

  appointmentId Int?
  appointment   Appointment? @relation(fields: [appointmentId], references: [appointmentId], onDelete: SetNull)

  staffId Int?
  hospitalStaff HospitalStaff? @relation(fields: [staffId], references: [staffId], onDelete: SetNull)

  hospitalId Int?
  hospital   Hospital? @relation(fields: [hospitalId], references: [hospitalId], onDelete: SetNull)

  emergencyRequests EmergencyRequest[] @relation("DonationFulfillsRequests")
}

model MedicalCheckup {
  checkupId  Int      @id @default(autoincrement())
  checkupDate DateTime @default(now())
  hemoglobin Float?
  bloodPressure String?
  weight     Float?
  result     String
  notes      String?
  createdAt  DateTime @default(now())

  donorId Int
  donor   Donor @relation(fields: [donorId], references: [donorId], onDelete: Cascade)

  staffId Int?
  hospitalStaff HospitalStaff? @relation(fields: [staffId], references: [staffId], onDelete: SetNull)

  hospitalId Int?
  hospital   Hospital? @relation(fields: [hospitalId], references: [hospitalId], onDelete: SetNull)
}

model BloodInventory {
  inventoryId   Int      @id @default(autoincrement())
  bloodType     String
  unitsAvailable Int     @default(0)
  minimumUnits  Int      @default(5)
  updatedAt     DateTime @default(now()) @updatedAt
  createdAt     DateTime @default(now())

  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [hospitalId], onDelete: Cascade)

  transactions InventoryTransaction[]

  @@unique([hospitalId, bloodType])
}

model HospitalStockSettings {
  settingsId                 Int      @id @default(autoincrement())
  historicalWindowDays       Int      @default(30)
  replenishmentLeadTimeDays   Int?
  safetyBufferDays            Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @default(now()) @updatedAt

  hospitalId Int      @unique
  hospital   Hospital @relation(fields: [hospitalId], references: [hospitalId], onDelete: Cascade)
}

model InventoryTransaction {
  transactionId Int      @id @default(autoincrement())
  transactionType String
  unitsChanged  Int
  reason        String?
  createdAt     DateTime @default(now())

  inventoryId Int
  inventory   BloodInventory @relation(fields: [inventoryId], references: [inventoryId], onDelete: Cascade)

  performedByUserId Int?
  performedByUser   User? @relation("UserInventoryTransactions", fields: [performedByUserId], references: [userId], onDelete: SetNull)

  requestId Int?
  request   EmergencyRequest? @relation(fields: [requestId], references: [requestId], onDelete: SetNull)
}

model EmergencyRequest {
  requestId        Int      @id @default(autoincrement())
  bloodType        String
  quantityRequired Int
  urgencyLevel     String
  status           String   @default("PENDING")
  latitude         Float?
  longitude        Float?
  currentWave      Int      @default(0)
  lastAlertAt      DateTime?
  requestDate      DateTime @default(now())
  neededBy         DateTime
  notes            String?
  fulfilledAt      DateTime?
  fulfilledQuantity Int?
  outcomeNotes     String?
  createdAt        DateTime @default(now())

updatedAt DateTime @default(now()) @updatedAt


  patientReference String? @db.VarChar(60)

  hospitalId Int?
  hospital   Hospital? @relation(fields: [hospitalId], references: [hospitalId], onDelete: SetNull)

  requestedByUserId Int?
  requestedByUser   User? @relation("UserCreatesEmergencyRequests", fields: [requestedByUserId], references: [userId], onDelete: SetNull)

  createdByStaffId Int?
  createdByStaff   HospitalStaff? @relation("StaffCreatesEmergencyRequests", fields: [createdByStaffId], references: [staffId], onDelete: SetNull)

  donationRecords       DonationRecord[]       @relation("DonationFulfillsRequests")
  matches               RequestMatch[]
  alerts                Alert[]
  notifications         Notification[]
  inventoryTransactions InventoryTransaction[]
  @@index([hospitalId, status, neededBy])
}

model RequestMatch {
  matchId     Int      @id @default(autoincrement())
  status      String   @default("MATCHED")
  wave        Int      @default(1)
  distanceKm  Float?
  notifiedAt  DateTime?
  responseAt  DateTime?
  createdAt   DateTime @default(now())

  requestId Int
  request   EmergencyRequest @relation(fields: [requestId], references: [requestId], onDelete: Cascade)

  donorId Int
  donor   Donor @relation(fields: [donorId], references: [donorId], onDelete: Cascade)

  @@unique([requestId, donorId])
}

model Alert {
  alertId   Int      @id @default(autoincrement())
  alertType String
  channel   String
  message   String
  status    String   @default("PENDING")
  sentAt    DateTime?
  createdAt DateTime @default(now())

  requestId Int?
  emergencyRequest EmergencyRequest? @relation(fields: [requestId], references: [requestId], onDelete: SetNull)

  userId Int?
  user   User? @relation("UserReceivesAlerts", fields: [userId], references: [userId], onDelete: SetNull)
}

model Notification {
  notificationId Int      @id @default(autoincrement())
  type           String
  channel        String
  title          String?
  message        String
  status         String   @default("PENDING")
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  userId Int?
  user   User? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  requestId Int?
  request   EmergencyRequest? @relation(fields: [requestId], references: [requestId], onDelete: SetNull)

}

model PasswordResetToken {
  tokenId   Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailOutbox {
  emailId        Int      @id @default(autoincrement())
  recipientEmail String
  template       String
  payload        Json
  status         String   @default("QUEUED")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lastError      String?
  createdAt      DateTime @default(now())
  sentAt         DateTime?
  processingAt   DateTime?

  @@index([status, nextAttemptAt])
}

model AuditLog {
  auditLogId Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actorUserId Int?
  actorUser   User? @relation("UserAuditLogs", fields: [actorUserId], references: [userId], onDelete: SetNull)
}
