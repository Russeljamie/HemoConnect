# Copy this file to .env.test and replace the placeholders.
# DATABASE_URL must point to a dedicated PostgreSQL database whose name ends in _test.
DATABASE_URL=postgresql://test_user:replace_me@localhost:5432/hemoconnect_test?schema=public

# Test-only JWT signing secret; replace with a unique random value of at least 32 characters.
JWT_SECRET=replace_with_a_unique_test_secret_at_least_32_characters
